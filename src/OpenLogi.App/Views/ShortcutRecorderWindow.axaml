<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OpenLogi.App.Localization"
        xmlns:vm="using:OpenLogi.App.ViewModels"
        x:Class="OpenLogi.App.Views.ShortcutRecorderWindow"
        x:DataType="vm:ShortcutRecorderViewModel"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Icon="/Assets/keyboard.png"
        Title="{loc:Tr ShortcutRecorder_Title}">
    <Window.Styles>
        <!-- Keycap look, matching the G-key picker's on-screen keyboard: a small flat
             key that turns blue while held (checked), and stays blue on hover/press. -->
        <Style Selector="ToggleButton.key">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="58"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Keycap outline: a grey rim with a heavier bottom edge, like a key seen from above -->
        <Style Selector="ToggleButton.key /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#10000000"/>
            <Setter Property="BorderBrush" Value="#8895A5"/>
            <Setter Property="BorderThickness" Value="1,1,1,3"/>
        </Style>
        <Style Selector="ToggleButton.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A000000"/>
            <Setter Property="BorderBrush" Value="#8895A5"/>
            <Setter Property="BorderThickness" Value="1,1,1,3"/>
        </Style>
        <!-- Held: the cap is pressed down (blue, thinner bottom edge) -->
        <Style Selector="ToggleButton.key:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4FD0"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.key:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3B74F2"/>
            <Setter Property="BorderBrush" Value="#1D4FD0"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.key:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4FD0"/>
            <Setter Property="BorderBrush" Value="#1D4FD0"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="20" Spacing="12">
        <!-- Waiting for a key: how to record. Key recorded: clear first to change it. -->
        <TextBlock Text="{Binding Hint}" Opacity="0.6" TextWrapping="Wrap"/>

        <!-- Live preview: exactly the text that will be stored and shown in the picker -->
        <Border Background="#15000000" Padding="12" CornerRadius="6">
            <TextBlock Text="{Binding Preview}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </Border>

        <!-- Sticky modifier keycaps in keyboard order (Shift, Ctrl, Win, Alt):
             pressed down by key presses, released by clicking -->
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ToggleButton Classes="key" Content="{Binding ShiftName}" IsChecked="{Binding Shift}"/>
                <ToggleButton Classes="key" Content="{Binding CtrlName}" IsChecked="{Binding Ctrl}"/>
                <ToggleButton Classes="key" Content="{Binding WinName}" IsChecked="{Binding Win}"/>
                <ToggleButton Classes="key" Content="{Binding AltName}" IsChecked="{Binding Alt}"/>
            </StackPanel>
            <!-- Clear resets the chord here; OK then stores "no shortcut" (the button does nothing) -->
            <Button Grid.Column="1" Content="{loc:Tr ShortcutRecorder_Clear}" Click="OnClear" MinWidth="84"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
            <Button Content="{loc:Tr ShortcutRecorder_OK}" Click="OnOk" MinWidth="84"/>
            <Button Content="{loc:Tr ShortcutRecorder_Cancel}" Click="OnCancel" MinWidth="84"/>
        </StackPanel>
    </StackPanel>
</Window>
