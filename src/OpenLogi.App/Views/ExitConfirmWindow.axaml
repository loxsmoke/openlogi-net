<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:OpenLogi.App.Localization"
        x:Class="OpenLogi.App.Views.ExitConfirmWindow"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Title="{loc:Tr ExitConfirm_ExitOpenlogiNet}">
    <StackPanel Margin="24" Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="18">
            <TextBlock Text="⚠" FontSize="48" Foreground="#E3B341" VerticalAlignment="Top"/>
            <StackPanel Spacing="8" MaxWidth="340">
                <TextBlock Text="{loc:Tr ExitConfirm_ExitOpenlogiNet}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Opacity="0.8" TextWrapping="Wrap"
                           Text="{loc:Tr ExitConfirm_WhileAppIsnTRunning}"/>
            </StackPanel>
        </StackPanel>
        <!-- Windows dialog convention: affirmative actions first, Cancel rightmost;
             the safe choice (tray) is the accented default (Enter), Cancel takes Esc. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="MinimizeButton" Content="{loc:Tr ExitConfirm_MinimizeTray}" Click="OnMinimize" MinWidth="130"
                    HorizontalContentAlignment="Center" IsDefault="True"
                    Background="#3B82F6" Foreground="White"/>
            <Button Content="{loc:Tr ExitConfirm_Exit}" Click="OnExit" MinWidth="84" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Tr ExitConfirm_Cancel}" Click="OnCancel" MinWidth="84" HorizontalContentAlignment="Center" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
